{
  "name": "@taskmaster/core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:tsup\" \"npm run dev:nodemon\"",
    "dev:tsup": "tsup src/index.ts --dts --watch",
    "dev:nodemon": "nodemon dist/index.js",
    "build": "tsup src/index.ts --dts --minify",
    "test": "jest --watchAll --collectCoverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/uuid": "^8.3.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "uuid": "^8.3.2"
  }
}
